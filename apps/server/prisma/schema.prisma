generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  password  String?
  username  String   @unique
  phone     String?  @unique
  role      String   @default("USER")
  wins      Int      @default(0)
  losses    Int      @default(0)
  rating    Int      @default(1200)
  deactivated Boolean @default(false)
  createdAt DateTime @default(now())

  tournamentSlots TournamentPlayer[]
  matchAsPlayerA  TournamentMatch[] @relation("MatchPlayerA")
  matchAsPlayerB  TournamentMatch[] @relation("MatchPlayerB")
  matchWins       TournamentMatch[] @relation("MatchWinner")
  tournamentsWon  Tournament[]      @relation("TournamentWinner")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Room {
  id           String   @id @default(cuid())
  code         String   @unique
  status       String   @default("waiting")
  gameType     String
  players      String   @default("[]")
  currentState String?
  winnerId     String?
  ownerId      String?
  maxRounds    Int      @default(1)
  scores       String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GameHistory {
  id        String   @id @default(cuid())
  winnerId  String?
  roomId    String
  gameName  String   @default("tic-tac-toe")
  players   String   @default("[]")
  data      String   @default("{}")
  createdAt DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     String   @default("{}")
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("system")
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Tournament {
  id         String   @id @default(cuid())
  name       String
  gameType   String   @default("tic-tac-toe")
  status     String   @default("registration") // registration | seeded | in_progress | completed
  maxPlayers Int      @default(16)
  bracket    String? // JSON serialized bracket tree (rounds -> match ids)
  winnerId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  winner  User?               @relation("TournamentWinner", fields: [winnerId], references: [id])
  players TournamentPlayer[]
  matches TournamentMatch[]

  @@index([status])
  @@map("tournaments")
}

model TournamentPlayer {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  seed         Int      @default(0) // 1-based seeding order
  joinedAt     DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@map("tournament_players")
}

model TournamentMatch {
  id           String    @id @default(cuid())
  tournamentId String
  round        Int       @default(1) // 1 = first round
  bracketIndex Int       @default(0) // 0-based position inside the round
  playerAId    String?
  playerBId    String?
  winnerId     String?
  nextMatchId  String? // match the winner advances to (null for the final)
  status       String    @default("pending") // pending | in_progress | completed
  playedAt     DateTime?

  tournament Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerA    User?               @relation("MatchPlayerA", fields: [playerAId], references: [id])
  playerB    User?               @relation("MatchPlayerB", fields: [playerBId], references: [id])
  winner     User?               @relation("MatchWinner", fields: [winnerId], references: [id])
  nextMatch  TournamentMatch?    @relation("NextMatch", fields: [nextMatchId], references: [id])
  previousMatches TournamentMatch[] @relation("NextMatch")

  @@unique([tournamentId, round, bracketIndex])
  @@index([tournamentId, status])
  @@map("tournament_matches")
}
