# ===== BaziGB — نمونه فایل محیطی =====
# روی سرور تولید: /opt/bazigb/.env (این فایل هرگز commit نمی‌شود)

NODE_ENV=development
PORT=8080

# --- ذخیره‌سازی ---
# DB_TYPE=file  → فایل JSON محلی (پیش‌فرض، بدون وابستگی)
# DB_TYPE=postgres → پایگاه‌داده Postgres (برای استقرار docker)
DB_TYPE=file
DATABASE_URL=postgres://bazigb:bazigb@db:5432/bazigb
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- وب ---
# آدرس API که مرورگر به آن وصل می‌شود (در توسعه: /api با پروکسی vite)
VITE_API_URL=/api

# --- دیپلوی Zero Build ---
# سرور تولید BaziGB
PROD_HOST=root@193.151.153.204
PROD_PATH=/opt/bazigb
