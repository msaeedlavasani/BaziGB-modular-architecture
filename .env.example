# ===== BaziGB — نمونه فایل محیطی =====
# روی سرور تولید: /opt/bazigb/.env (این فایل هرگز commit نمی‌شود)

NODE_ENV=development
PORT=8080

# --- دیتابیس ---
# دیتابیس فعلی SQLite است که از طریق Prisma مدیریت می‌شود.
# مسیر فایل در schema.prisma تعریف شده (file:./dev.db).
# نیازی به متغیر DATABASE_URL در این فایل نیست.

# --- تنظیمات امنیتی و SMS ---
# این مقادیر محرمانه هستند و فقط روی سرور (.env) ست می‌شوند.
JWT_SECRET=
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=997360

# --- Seed محلی مدیر ---
# اسکریپت seed بدون هر سه مقدار متوقف می‌شود. مقدار واقعی را commit نکنید.
SEED_EMAIL=
SEED_USERNAME=
SEED_PASSWORD=

# --- وب ---
# آدرس API که مرورگر به آن وصل می‌شود (در توسعه: /api با پروکسی vite)
VITE_API_URL=/api

# فقط برای بررسی ظاهر در Next محلی: نام سطح‌ها با کاما جدا می‌شوند، مانند
# leaderboard,tournaments. این سوئیچ در NODE_ENV=production به‌طور قطعی غیرفعال است.
NEXT_PUBLIC_BAZIGB_UI_DEMOS=

# --- دیپلوی Zero Build ---
# سرور تولید BaziGB
PROD_HOST=root@193.151.153.204
PROD_PATH=/opt/bazigb
