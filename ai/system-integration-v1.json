{
  "version": "1.0.0",
  "capabilities": [
    {
      "id": "human-direction",
      "name": "Human Direction",
      "purpose": "Own intent, priorities, values, risk appetite, budget, and consequential approval.",
      "inputs": ["evidence", "options", "risks", "resource-request"],
      "outputs": ["direction", "priority", "approval-or-rejection"],
      "evidence": ["explicit-human-decision"],
      "aiAuthority": ["prepare-options", "surface-tradeoffs", "request-approval"],
      "humanAuthority": ["set-intent", "approve-material-change", "approve-critical-action", "approve-elevated-resource-use"],
      "escalatesWhen": ["intent-is-ambiguous", "authority-would-expand", "risk-appetite-is-required"],
      "stages": ["Discovery", "Strategy", "Design", "Delivery", "Evolution"]
    },
    {
      "id": "ai-orchestration",
      "name": "AI Orchestration",
      "purpose": "Route work, maintain the task envelope, coordinate capabilities, and stop at gates.",
      "inputs": ["human-direction", "canonical-sources", "current-evidence"],
      "outputs": ["task-envelope", "capability-route", "bounded-plan", "escalation"],
      "evidence": ["routing-record", "scope-and-gate-review"],
      "aiAuthority": ["inspect", "classify", "route", "plan", "coordinate-within-approved-scope"],
      "humanAuthority": ["approve-material-plan", "change-scope"],
      "escalatesWhen": ["required-capability-is-missing", "sources-conflict", "decision-crosses-gate"],
      "stages": ["Discovery", "Research", "Strategy", "Design", "Engineering", "Validation", "Delivery", "Operations", "Evolution"]
    },
    {
      "id": "product-discovery",
      "name": "Product Discovery",
      "purpose": "Frame user problems and opportunities before solution commitment.",
      "inputs": ["human-direction", "user-signal", "product-context"],
      "outputs": ["problem-frame", "assumption-ledger", "discovery-decision"],
      "evidence": ["user-or-market-signal", "assumptions-and-unknowns"],
      "aiAuthority": ["synthesize-signals", "identify-assumptions", "propose-discovery-options"],
      "humanAuthority": ["select-opportunity", "reject-opportunity"],
      "escalatesWhen": ["problem-is-unverified", "solution-is-prescribed-without-outcome"],
      "stages": ["Discovery", "Evolution"]
    },
    {
      "id": "research-strategy",
      "name": "Research and Strategy",
      "purpose": "Produce sourced understanding and select measurable outcomes and constraints.",
      "inputs": ["problem-frame", "research-question", "existing-evidence"],
      "outputs": ["research-synthesis", "uncertainty-record", "strategy-decision", "success-measures"],
      "evidence": ["source-provenance", "confidence-and-limitations", "decision-rationale"],
      "aiAuthority": ["research-within-approved-resource-class", "synthesize", "propose-strategy"],
      "humanAuthority": ["approve-strategy", "accept-risk-and-uncertainty"],
      "escalatesWhen": ["evidence-is-insufficient", "research-cost-escalates", "strategy-changes-product-intent"],
      "stages": ["Research", "Strategy", "Evolution"]
    },
    {
      "id": "product-design",
      "name": "Product Design",
      "purpose": "Define coherent flows, hierarchy, interaction, content, accessibility, and experience evidence.",
      "inputs": ["approved-outcome", "research-synthesis", "design-system-contracts"],
      "outputs": ["experience-contract", "flow-and-state-model", "system-contribution-request"],
      "evidence": ["design-rationale", "state-coverage", "accessibility-and-content-review"],
      "aiAuthority": ["propose-and-evaluate-design-within-approved-outcome"],
      "humanAuthority": ["approve-material-experience-change"],
      "escalatesWhen": ["new-shared-pattern-is-needed", "product-hierarchy-changes", "research-does-not-support-choice"],
      "stages": ["Design", "Evolution"]
    },
    {
      "id": "design-system",
      "name": "Design System",
      "purpose": "Turn reusable experience needs into versioned, tested, adoptable product patterns.",
      "inputs": ["system-contribution-request", "usage-evidence", "existing-patterns"],
      "outputs": ["pattern-contract", "reference-implementation", "maturity-decision", "conformance-evaluation"],
      "evidence": ["responsive-content-accessibility-contract", "component-example", "regression-fixture"],
      "aiAuthority": ["reuse", "compose", "propose-contribution", "implement-approved-contract"],
      "humanAuthority": ["approve-material-system-contract"],
      "escalatesWhen": ["stable-contract-would-change", "new-brand-or-interaction-language-is-created"],
      "stages": ["Design", "Engineering", "Validation", "Evolution"]
    },
    {
      "id": "engineering",
      "name": "Engineering",
      "purpose": "Implement approved contracts while preserving architecture, protocol, type, and dependency invariants.",
      "inputs": ["approved-contract", "architecture-context", "acceptance-criteria"],
      "outputs": ["implementation", "tests", "technical-notes"],
      "evidence": ["diff", "targeted-tests", "build-or-type-evidence", "boundary-evidence"],
      "aiAuthority": ["implement-routine-work", "implement-approved-material-scope", "validate"],
      "humanAuthority": ["approve-architecture-or-protocol-change", "approve-dependency-change"],
      "escalatesWhen": ["architecture-must-change", "scope-expands", "required-contract-is-absent"],
      "stages": ["Engineering", "Validation", "Evolution"]
    },
    {
      "id": "security-privacy",
      "name": "Security and Privacy",
      "purpose": "Protect identity, authorization, data, protocols, secrets, abuse boundaries, and privacy obligations.",
      "inputs": ["threat-surface", "data-flow", "implementation-or-design"],
      "outputs": ["security-requirements", "threat-model-or-scan", "validated-findings", "release-blockers"],
      "evidence": ["source-to-sink-analysis", "security-regression", "residual-risk"],
      "aiAuthority": ["inspect", "model-threats", "validate", "propose-remediation"],
      "humanAuthority": ["approve-remediation-scope", "accept-material-residual-risk", "authorize-secret-or-production-action"],
      "escalatesWhen": ["critical-finding-exists", "personal-data-changes", "production-exposure-changes"],
      "stages": ["Research", "Strategy", "Design", "Engineering", "Validation", "Delivery", "Operations", "Evolution"]
    },
    {
      "id": "evaluation-quality",
      "name": "Evaluation and Quality",
      "purpose": "Challenge claims with proportional evidence against product and system contracts.",
      "inputs": ["acceptance-criteria", "risk-classification", "candidate-output"],
      "outputs": ["evaluation-plan", "pass-fail-blocked-not-run-result", "regression-evidence"],
      "evidence": ["executed-checks", "limitations", "claim-to-evidence-map"],
      "aiAuthority": ["select-proportional-checks", "execute-approved-evaluation", "reject-unsupported-claim"],
      "humanAuthority": ["accept-subjective-product-quality", "waive-material-gate"],
      "escalatesWhen": ["evidence-is-inconclusive", "required-environment-is-unavailable", "risk-requires-independent-review"],
      "stages": ["Discovery", "Research", "Design", "Engineering", "Validation", "Delivery", "Operations", "Evolution"]
    },
    {
      "id": "delivery-operations",
      "name": "Delivery and Operations",
      "purpose": "Release safely, observe service behavior, recover from failure, and maintain continuity.",
      "inputs": ["validated-release-candidate", "release-authority", "rollback-and-observability-plan"],
      "outputs": ["release-record", "deployment-state", "operational-evidence", "incident-or-recovery-record"],
      "evidence": ["release-gate", "rollback-or-recovery-proof", "monitoring-signal"],
      "aiAuthority": ["prepare-release", "inspect-status", "execute-explicitly-authorized-routine-operations"],
      "humanAuthority": ["authorize-deploy", "authorize-production-migration", "approve-destructive-recovery"],
      "escalatesWhen": ["rollback-is-unproven", "production-state-is-uncertain", "incident-threshold-is-crossed"],
      "stages": ["Delivery", "Operations", "Evolution"]
    },
    {
      "id": "governance-versioning",
      "name": "Governance and Versioning",
      "purpose": "Preserve authority, traceability, source precedence, decision state, and recoverable history.",
      "inputs": ["decision", "artifact", "evidence", "release-state"],
      "outputs": ["decision-record", "version-state", "registered-report", "supersession-link"],
      "evidence": ["repository-state", "validation-state", "remote-or-backup-verification"],
      "aiAuthority": ["record", "compare", "validate-governance", "report-exact-state"],
      "humanAuthority": ["approve-commit", "approve-push", "approve-merge", "approve-publication"],
      "escalatesWhen": ["sources-conflict", "state-cannot-be-verified", "canonical-contract-changes"],
      "stages": ["Discovery", "Research", "Strategy", "Design", "Engineering", "Validation", "Delivery", "Operations", "Evolution"]
    },
    {
      "id": "cost-resource-governance",
      "name": "Cost and Resource Governance",
      "purpose": "Match token, compute, runtime, network, storage, and paid-service cost to decision risk and value.",
      "inputs": ["resource-class", "uncertainty", "proposed-method"],
      "outputs": ["resource-decision", "approval-request", "stopping-condition"],
      "evidence": ["cheaper-alternative-analysis", "expected-risk-reduction", "actual-resource-class"],
      "aiAuthority": ["use-standard-resources", "de-escalate", "request-elevated-or-intensive-resources"],
      "humanAuthority": ["approve-elevated-resources", "approve-intensive-resources", "approve-recurring-paid-cost"],
      "escalatesWhen": ["standard-method-is-insufficient", "marginal-value-declines", "paid-cost-is-introduced"],
      "stages": ["Discovery", "Research", "Strategy", "Design", "Engineering", "Validation", "Delivery", "Operations", "Evolution"]
    },
    {
      "id": "knowledge-management",
      "name": "Knowledge Management",
      "purpose": "Keep durable knowledge canonical, concise, transferable, retrievable, and resilient.",
      "inputs": ["durable-learning", "important-report", "canonical-change"],
      "outputs": ["canonical-document", "registry-entry", "retrieval-or-backup-evidence"],
      "evidence": ["source-link", "provenance", "retrieval-check", "supersession-state"],
      "aiAuthority": ["update-approved-canonical-source", "register-report", "verify-retrieval"],
      "humanAuthority": ["approve-external-publication", "approve-retention-or-disposal-policy"],
      "escalatesWhen": ["canonical-home-is-unclear", "sensitive-data-would-be-stored", "off-device-copy-is-unverified"],
      "stages": ["Discovery", "Research", "Strategy", "Design", "Engineering", "Validation", "Delivery", "Operations", "Evolution"]
    },
    {
      "id": "continuous-learning",
      "name": "Continuous Learning",
      "purpose": "Convert evidence, recurrence, incidents, and experiments into improved controls and priorities.",
      "inputs": ["failure-or-signal", "root-control-analysis", "evaluation-result"],
      "outputs": ["system-change", "regression-mechanism", "supersession-or-backlog-decision"],
      "evidence": ["acceptance-case", "changed-control", "recurrence-detection"],
      "aiAuthority": ["classify-root-control", "propose-learning", "implement-approved-system-change"],
      "humanAuthority": ["approve-material-system-evolution", "reprioritize-product"],
      "escalatesWhen": ["failure-repeats", "learning-changes-product-or-system-intent", "control-owner-is-missing"],
      "stages": ["Evolution", "Discovery", "Strategy"]
    }
  ],
  "lifecycle": [
    {"stage":"Discovery","accountable":"product-discovery","requiredInput":"human-direction-or-observed-signal","output":"problem-frame","evidence":"user-or-market-signal","humanGate":"opportunity-selection-when-material","receiver":"Research","rejectWhen":"problem-or-user-is-undefined"},
    {"stage":"Research","accountable":"research-strategy","requiredInput":"problem-frame-and-research-question","output":"research-synthesis","evidence":"source-provenance-and-uncertainty","humanGate":"resource-approval-if-elevated","receiver":"Strategy","rejectWhen":"material-claims-lack-evidence"},
    {"stage":"Strategy","accountable":"research-strategy","requiredInput":"research-synthesis","output":"outcome-constraints-success-measures","evidence":"decision-rationale","humanGate":"approve-product-strategy","receiver":"Design","rejectWhen":"outcome-or-non-goals-are-absent"},
    {"stage":"Design","accountable":"product-design","requiredInput":"approved-outcome-and-system-contracts","output":"experience-contract","evidence":"flow-state-accessibility-content-review","humanGate":"approve-material-experience-or-system-change","receiver":"Engineering","rejectWhen":"states-or-shared-contributions-are-unresolved"},
    {"stage":"Engineering","accountable":"engineering","requiredInput":"approved-contract-and-acceptance-criteria","output":"implementation-and-tests","evidence":"diff-targeted-tests-boundaries","humanGate":"approve-material-architecture-protocol-or-dependency-change","receiver":"Validation","rejectWhen":"implementation-diverges-from-contract"},
    {"stage":"Validation","accountable":"evaluation-quality","requiredInput":"candidate-output-risk-and-acceptance-criteria","output":"pass-fail-blocked-not-run-result","evidence":"claim-to-evidence-map","humanGate":"accept-subjective-quality-or-material-waiver","receiver":"Delivery","rejectWhen":"required-evidence-is-missing-or-failed"},
    {"stage":"Delivery","accountable":"delivery-operations","requiredInput":"validated-release-candidate-and-release-authority","output":"release-record-and-recoverable-state","evidence":"release-gate-and-rollback-proof","humanGate":"authorize-deploy","receiver":"Operations","rejectWhen":"authority-or-recovery-evidence-is-absent"},
    {"stage":"Operations","accountable":"delivery-operations","requiredInput":"deployed-service-and-observability","output":"operational-evidence","evidence":"monitoring-incident-recovery-signal","humanGate":"approve-critical-operational-action","receiver":"Evolution","rejectWhen":"service-state-cannot-be-observed"},
    {"stage":"Evolution","accountable":"continuous-learning","requiredInput":"evaluation-user-or-operational-signal","output":"system-strategy-or-backlog-change","evidence":"root-control-analysis-and-regression-mechanism","humanGate":"approve-material-system-evolution","receiver":"Discovery","rejectWhen":"learning-has-no-owner-or-destination"}
  ],
  "crossCuttingRequired": [
    "human-direction",
    "ai-orchestration",
    "security-privacy",
    "evaluation-quality",
    "governance-versioning",
    "cost-resource-governance",
    "knowledge-management",
    "continuous-learning"
  ],
  "integrationFixture": {
    "input": "Prepare a multiplayer protocol change for production release after user reports of duplicate game actions.",
    "requiredStages": ["Discovery", "Research", "Strategy", "Design", "Engineering", "Validation", "Delivery", "Operations", "Evolution"],
    "requiredCapabilities": ["Human Direction", "AI Orchestration", "Product Discovery", "Research and Strategy", "Product Design", "Engineering", "Security and Privacy", "Evaluation and Quality", "Delivery and Operations", "Governance and Versioning", "Cost and Resource Governance", "Knowledge Management", "Continuous Learning"],
    "decisionClass": "Material",
    "resourceClass": "Standard",
    "firstGate": "approve-protocol-change-plan",
    "forbiddenShortcut": "implement-from-user-symptom-without-protocol-root-analysis",
    "releaseRequires": ["explicit-deploy-authority", "protocol-regression-evidence", "rollback-or-recovery-proof"],
    "learningDestination": "protocol-invariant-and-regression-suite"
  }
}
