#!/usr/bin/env bash
# Root-owned production controller. Install as /usr/local/sbin/bazigb-release.
set -euo pipefail

ROOT="${BAZIGB_RELEASE_ROOT:-/srv/bazigb}"
RELEASES="${ROOT}/releases"
SHARED="${ROOT}/shared"
CURRENT="${ROOT}/current"
PREVIOUS="${ROOT}/previous"
DEPLOY_USER="bazigb-deploy"
RUNTIME_USER="bazigb-runtime"
APP_GROUP="bazigb-app"
SQLITE_BACKUP="${BAZIGB_SQLITE_BACKUP:-/usr/local/sbin/bazigb-sqlite-backup}"
SYSTEMD_ROOT="${BAZIGB_SYSTEMD_ROOT:-/etc/systemd/system}"
LEGACY_ROOT="${BAZIGB_LEGACY_ROOT:-/opt/bazigb}"
SERVER_UNIT="${SYSTEMD_ROOT}/bazigb-server.service"
WEB_UNIT="${SYSTEMD_ROOT}/bazigb-web.service"
SERVER_UNIT_NEXT="${SERVER_UNIT}.next"
WEB_UNIT_NEXT="${WEB_UNIT}.next"
API_HEALTH_URL="${BAZIGB_API_HEALTH_URL:-http://127.0.0.1:3001/api/rooms}"
CANDIDATE_WEB_HEALTH_URL="${BAZIGB_CANDIDATE_WEB_HEALTH_URL:-http://127.0.0.1:3000/fa/lobby}"
LEGACY_WEB_HEALTH_URL="${BAZIGB_LEGACY_WEB_HEALTH_URL:-http://127.0.0.1:3000/lobby}"
HEALTH_DEADLINE_SECONDS="${BAZIGB_HEALTH_DEADLINE_SECONDS:-30}"
HEALTH_RETRY_SECONDS="${BAZIGB_HEALTH_RETRY_SECONDS:-2}"
HEALTH_MAX_ATTEMPTS="${BAZIGB_HEALTH_MAX_ATTEMPTS:-0}"
CANARY_API_PORT=3101
CANARY_WEB_PORT=3100
CANARY_RUNTIME_SECONDS=90
CANARY_ROOT="${BAZIGB_CANARY_ROOT:-/run/bazigb-canary}"
EVIDENCE_DIR="${BAZIGB_EVIDENCE_DIR:-/var/log/bazigb-release}"
EVIDENCE_FILE="${EVIDENCE_DIR}/canary-evidence.jsonl"

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

release_id="${2:-}"
expected_lock="${3:-}"
[[ "${release_id}" =~ ^[0-9a-f]{7,40}$ ]] || die 'Invalid release id.'
candidate="${RELEASES}/${release_id}"
[[ "${candidate}" == "${RELEASES}/"* ]] || die 'Release path escaped the release root.'

verify() {
  [[ "${#expected_lock}" -eq 64 ]] || die 'Invalid package-lock checksum length.'
  [[ "${expected_lock}" != *[!0-9a-f]* ]] || die 'Invalid package-lock checksum characters.'
  [[ -f "${candidate}/release.manifest" ]] || die 'Candidate manifest is missing.'
  [[ -f "${candidate}/package-lock.json" ]] || die 'Candidate package-lock is missing.'
  actual_lock="$(sha256sum "${candidate}/package-lock.json" | awk '{print $1}')"
  [[ "${actual_lock}" == "${expected_lock}" ]] || die 'Candidate package-lock checksum mismatch.'
  grep -Fxq "release_id=${release_id}" "${candidate}/release.manifest" || die 'Manifest release id mismatch.'
  grep -Fxq "git_revision=${release_id}" "${candidate}/release.manifest" || die 'Manifest Git revision mismatch.'
  [[ -f "${candidate}/apps/server/dist/main.js" ]] || die 'Server build output is missing.'
  [[ -f "${candidate}/apps/web/.next/standalone/apps/web/server.js" ]] || die 'Web build output is missing.'
  [[ -f "${candidate}/node_modules/.prisma/client/default.js" ]] || die 'Generated Prisma client is missing.'
  ! grep -Fq '@prisma/client did not initialize yet' \
    "${candidate}/node_modules/.prisma/client/default.js" || die 'Generated Prisma client is missing.'
}

append_canary_evidence() {
  result="$1"
  api_status="$2"
  web_status="$3"
  db_checksum="$4"
  started_at="$5"
  finished_at="$6"
  install -d -m 0750 -o root -g "${APP_GROUP}" "${EVIDENCE_DIR}"
  touch "${EVIDENCE_FILE}"
  chown root:"${APP_GROUP}" "${EVIDENCE_FILE}"
  chmod 0640 "${EVIDENCE_FILE}"
  (
    flock -x 9
    printf '{"schemaVersion":"1.0.0","event":"release_canary","releaseId":"%s","result":"%s","apiHttp":"%s","webHttp":"%s","snapshotSha256":"%s","startedAt":"%s","finishedAt":"%s"}\n' \
      "${release_id}" "${result}" "${api_status}" "${web_status}" \
      "${db_checksum}" "${started_at}" "${finished_at}" >&9
  ) 9>>"${EVIDENCE_FILE}"
}

canary() {
  [[ "$#" -eq 3 ]] || die 'Canary requires exactly RELEASE_ID and LOCK_SHA256.'
  [[ "$(id -u)" -eq 0 ]] || die 'Canary must run through the approved root controller.'
  verify
  command -v systemd-run >/dev/null 2>&1 || die 'systemd-run is required.'
  command -v flock >/dev/null 2>&1 || die 'flock is required.'
  [[ -f "${SHARED}/.env" ]] || die 'Shared environment file is missing.'
  [[ -f "${SHARED}/data/dev.db" ]] || die 'Shared SQLite database is missing.'

  api_unit="bazigb-api-canary-${release_id}"
  web_unit="bazigb-web-canary-${release_id}"
  run_dir="${CANARY_ROOT}/${release_id}-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  snapshot="${run_dir}/canary.db"
  started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  api_status='not_run'
  web_status='not_run'
  db_checksum='not_created'
  result='FAIL'
  evidence_written=0

  cleanup_canary() {
    systemctl stop "${api_unit}.service" "${web_unit}.service" >/dev/null 2>&1 || :
    systemctl reset-failed "${api_unit}.service" "${web_unit}.service" >/dev/null 2>&1 || :
    if [[ "${run_dir}" == "${CANARY_ROOT}/"* && -d "${run_dir}" ]]; then
      rm -rf -- "${run_dir}"
    fi
    if [[ "${evidence_written}" -eq 0 ]]; then
      finished_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      append_canary_evidence "${result}" "${api_status}" "${web_status}" \
        "${db_checksum}" "${started_at}" "${finished_at}"
      evidence_written=1
    fi
  }
  trap cleanup_canary EXIT INT TERM

  install -d -m 0700 -o "${RUNTIME_USER}" -g "${RUNTIME_USER}" "${run_dir}"
  "${SQLITE_BACKUP}" "${SHARED}/data/dev.db" "${snapshot}"
  chown "${RUNTIME_USER}:${RUNTIME_USER}" "${snapshot}"
  chmod 0600 "${snapshot}"
  db_checksum="$(sha256sum "${snapshot}" | awk '{print $1}')"

  for port in "${CANARY_API_PORT}" "${CANARY_WEB_PORT}"; do
    if ss -H -ltn "sport = :${port}" | grep -q .; then
      die "Canary port ${port} is already in use."
    fi
  done

  systemd-run --quiet --collect --unit="${api_unit}" \
    --uid="${RUNTIME_USER}" --gid="${APP_GROUP}" \
    --property="SupplementaryGroups=${RUNTIME_USER}" \
    --property="WorkingDirectory=${candidate}/apps/server" \
    --property="EnvironmentFile=${SHARED}/.env" \
    --property="RuntimeMaxSec=${CANARY_RUNTIME_SECONDS}" \
    --property=CPUQuota=100% --property=MemoryMax=512M --property=TasksMax=128 \
    --property=NoNewPrivileges=yes --property=PrivateTmp=yes \
    --property=ProtectSystem=strict --property="ReadWritePaths=${run_dir}" \
    --property=StandardOutput=null --property=StandardError=null \
    --setenv="PORT=${CANARY_API_PORT}" \
    --setenv="DATABASE_URL=file:${snapshot}" \
    --setenv=PATH=/opt/bazigb-runtime/current/bin:/usr/bin:/bin \
    /opt/bazigb-runtime/current/bin/node dist/main.js

  systemd-run --quiet --collect --unit="${web_unit}" \
    --uid="${RUNTIME_USER}" --gid="${APP_GROUP}" \
    --property="WorkingDirectory=${candidate}/apps/web" \
    --property="RuntimeMaxSec=${CANARY_RUNTIME_SECONDS}" \
    --property=CPUQuota=100% --property=MemoryMax=768M --property=TasksMax=128 \
    --property=NoNewPrivileges=yes --property=PrivateTmp=yes \
    --property=ProtectSystem=strict \
    --property=StandardOutput=null --property=StandardError=null \
    --setenv="PORT=${CANARY_WEB_PORT}" \
    --setenv=PATH=/opt/bazigb-runtime/current/bin:/usr/bin:/bin \
    /opt/bazigb-runtime/current/bin/node .next/standalone/apps/web/server.js

  api_url="http://127.0.0.1:${CANARY_API_PORT}/api/rooms"
  web_url="http://127.0.0.1:${CANARY_WEB_PORT}/fa/lobby"
  deadline=$((SECONDS + CANARY_RUNTIME_SECONDS))
  while (( SECONDS <= deadline )); do
    api_status="$(curl --silent --output /dev/null --write-out '%{http_code}' \
      --connect-timeout 2 --max-time 5 "${api_url}" || :)"
    web_status="$(curl --silent --output /dev/null --write-out '%{http_code}' \
      --connect-timeout 2 --max-time 5 "${web_url}" || :)"
    if [[ "${api_status}" == '200' && "${web_status}" == '200' ]]; then
      result='PASS'
      break
    fi
    sleep 2
  done
  [[ "${result}" == 'PASS' ]] || die 'Canary health checks did not both return HTTP 200.'

  finished_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  append_canary_evidence "${result}" "${api_status}" "${web_status}" \
    "${db_checksum}" "${started_at}" "${finished_at}"
  evidence_written=1
  printf 'canary_ok release_id=%s api_http=%s web_http=%s evidence=%s\n' \
    "${release_id}" "${api_status}" "${web_status}" "${EVIDENCE_FILE}"
  cleanup_canary
  trap - EXIT INT TERM
}

prepare() {
  [[ ! -e "${candidate}" ]] || die 'Release directory already exists; candidates are immutable.'
  install -d -m 2750 -o "${DEPLOY_USER}" -g "${APP_GROUP}" "${candidate}"
}

link_persistent_data() {
  ensure_persistent_link "${SHARED}/.env" "${candidate}/.env" '.env'
  ensure_persistent_link "${SHARED}/data/dev.db" "${candidate}/apps/server/prisma/dev.db" 'dev.db'
}

ensure_persistent_link() {
  target="$1"
  link="$2"
  label="$3"
  if [[ -L "${link}" && "$(readlink "${link}")" == "${target}" ]]; then
    return 0
  fi
  [[ ! -e "${link}" && ! -L "${link}" ]] || die "Candidate unexpectedly contains ${label}."
  ln -s "${target}" "${link}"
}

database_checkpoint() {
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  destination="${SHARED}/backups/dev-${timestamp}-before-${release_id}.db"
  [[ -x "${SQLITE_BACKUP}" ]] || die 'The approved SQLite backup helper is missing.'
  "${SQLITE_BACKUP}" "${SHARED}/data/dev.db" "${destination}"
  chown root:root "${destination}"
  chmod 0600 "${destination}"
}

verify_runtime_environment() {
  grep -Eq '^TRUST_PROXY_HOPS=1$' "${SHARED}/.env" ||
    die 'Shared environment must declare TRUST_PROXY_HOPS=1 for the canonical single-proxy topology.'
}

probe_endpoint() {
  label="$1"
  url="$2"
  deadline=$((SECONDS + HEALTH_DEADLINE_SECONDS))
  attempts=0
  last_class='not_attempted'
  last_status='none'

  while (( SECONDS <= deadline )); do
    attempts=$((attempts + 1))
    set +e
    http_status="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
      --connect-timeout 2 --max-time 5 "${url}")"
    curl_status=$?
    set -e

    if [[ "${curl_status}" -eq 0 && "${http_status}" =~ ^[23][0-9][0-9]$ ]]; then
      printf 'health_ok endpoint=%s status=%s\n' "${label}" "${http_status}"
      return 0
    fi

    last_status="${http_status:-none}"
    case "${curl_status}" in
      7) last_class='connection_failure' ;;
      28) last_class='timeout' ;;
      0)
        if [[ "${http_status}" == '404' ]]; then
          last_class='http_404'
        else
          last_class='http_error'
        fi
        ;;
      *) last_class='transport_error' ;;
    esac
    if [[ "${HEALTH_MAX_ATTEMPTS}" -gt 0 && "${attempts}" -ge "${HEALTH_MAX_ATTEMPTS}" ]]; then
      break
    fi
    sleep "${HEALTH_RETRY_SECONDS}"
  done

  printf 'health_fail endpoint=%s class=%s status=%s\n' \
    "${label}" "${last_class}" "${last_status}" >&2
  return 1
}

health_check() {
  web_url="$1"
  api_status=0
  web_status=0
  probe_endpoint api "${API_HEALTH_URL}" || api_status=$?
  probe_endpoint web "${web_url}" || web_status=$?
  [[ "${api_status}" -eq 0 && "${web_status}" -eq 0 ]]
}

prepare_first_cutover() {
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  first_cutover_checkpoint="${SHARED}/backups/first-cutover-${timestamp}"
  [[ -d "${LEGACY_ROOT}" ]] || die 'Legacy application root is missing.'
  [[ -f "${SERVER_UNIT}" && -f "${WEB_UNIT}" ]] || die 'Active legacy units are missing.'
  [[ -f "${SERVER_UNIT_NEXT}" && -f "${WEB_UNIT_NEXT}" ]] || die 'Staged release units are missing.'
  grep -Fxq 'EnvironmentFile=/srv/bazigb/shared/.env' "${SERVER_UNIT_NEXT}" ||
    die 'Staged server unit must load the shared environment file.'
  grep -Fxq 'Environment=PATH=/opt/bazigb-runtime/current/bin:/usr/bin:/bin' "${SERVER_UNIT_NEXT}" ||
    die 'Staged server unit must declare the pinned Node PATH.'
  grep -Fxq 'SupplementaryGroups=bazigb-runtime' "${SERVER_UNIT_NEXT}" ||
    die 'Staged server unit must retain access to the protected runtime group.'
  install -d -m 0700 -o root -g root "${first_cutover_checkpoint}"
  cp -a "${SERVER_UNIT}" "${first_cutover_checkpoint}/bazigb-server.service"
  cp -a "${WEB_UNIT}" "${first_cutover_checkpoint}/bazigb-web.service"
}

install_staged_units() {
  install -m 0644 -o root -g root "${SERVER_UNIT_NEXT}" "${SERVER_UNIT}"
  install -m 0644 -o root -g root "${WEB_UNIT_NEXT}" "${WEB_UNIT}"
  systemctl daemon-reload
}

restore_legacy_units() {
  install -m 0644 -o root -g root \
    "${first_cutover_checkpoint}/bazigb-server.service" "${SERVER_UNIT}"
  install -m 0644 -o root -g root \
    "${first_cutover_checkpoint}/bazigb-web.service" "${WEB_UNIT}"
  systemctl daemon-reload
  if [[ -L "${CURRENT}" ]]; then
    mv -Tf "${CURRENT}" "${ROOT}/.failed-${release_id}"
  fi
}

activate() {
  verify
  [[ -f "${SHARED}/.env" ]] || die 'Shared environment file is missing.'
  [[ -f "${SHARED}/data/dev.db" ]] || die 'Shared SQLite database is missing.'
  verify_runtime_environment
  link_persistent_data
  database_checkpoint

  old_target=''
  first_cutover_checkpoint=''
  if [[ -L "${CURRENT}" ]]; then
    old_target="$(readlink "${CURRENT}")"
    ln -sfn "${old_target}" "${PREVIOUS}"
  else
    prepare_first_cutover
    install_staged_units
  fi
  ln -s "${candidate}" "${ROOT}/.current-${release_id}"
  mv -Tf "${ROOT}/.current-${release_id}" "${CURRENT}"
  if systemctl restart bazigb-server bazigb-web && health_check "${CANDIDATE_WEB_HEALTH_URL}"; then
    return 0
  fi

  if [[ -n "${old_target}" ]]; then
    ln -s "${old_target}" "${ROOT}/.rollback-${release_id}"
    mv -Tf "${ROOT}/.rollback-${release_id}" "${CURRENT}"
    systemctl restart bazigb-server bazigb-web
    health_check "${CANDIDATE_WEB_HEALTH_URL}" || die 'Activation and rollback health checks both failed.'
  else
    restore_legacy_units
    systemctl restart bazigb-server bazigb-web
    health_check "${LEGACY_WEB_HEALTH_URL}" || die 'First activation and legacy rollback health checks both failed.'
  fi
  die 'Activation health check failed; previous release restored.'
}

case "${1:-}" in
  prepare) prepare ;;
  verify) verify ;;
  canary|preflight) canary ;;
  activate) activate ;;
  *) die 'Usage: bazigb-release {prepare|verify|canary|preflight|activate} RELEASE_ID [LOCK_SHA256]' ;;
esac
