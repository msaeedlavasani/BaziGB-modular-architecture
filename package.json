{
  "name": "bazigb",
  "version": "1.0.0",
  "private": true,
  "description": "BaziGB — بستر بازی‌های آنلاین: نرد، دوز، شطرنج و وگاس (معماری مدولار)",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/games/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build -w @bazigb/engine -w @bazigb/game-tic-tac-toe -w @bazigb/game-backgammon -w @bazigb/game-chess -w @bazigb/game-vegas",
    "build:web": "npm run build -w @bazigb/web",
    "build:server": "npm run build -w @bazigb/server",
    "dev": "node scripts/local-runtime.mjs start",
    "dev:status": "node scripts/local-runtime.mjs status",
    "dev:stop": "node scripts/local-runtime.mjs stop",
    "dev:restart": "node scripts/local-runtime.mjs restart",
    "dev:web": "npm run dev -w @bazigb/web",
    "dev:server": "npm run dev -w @bazigb/server",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "test:design-system": "node scripts/check-design-system.test.mjs",
    "check:governance": "node scripts/check-governance.mjs",
    "test:governance": "node scripts/check-governance.test.mjs",
    "check:branch-health": "node scripts/check-branch-health.mjs --enforce",
    "test:branch-health": "node scripts/check-branch-health.test.mjs",
    "check:task-package": "node scripts/check-task-package.mjs",
    "test:task-package": "node scripts/check-task-package.test.mjs",
    "task:passport": "node scripts/generate-task-passport.mjs",
    "check:sensitive-diff": "node scripts/check-sensitive-diff.mjs",
    "test:sensitive-diff": "node scripts/check-sensitive-diff.test.mjs",
    "test:release-safety": "node --test scripts/release-safety.test.mjs",
    "test:release-artifact": "bash scripts/release-artifact-smoke.sh",
    "typecheck": "npm run check:boundaries && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:games": "npm run test -w @bazigb/engine -w @bazigb/game-tic-tac-toe -w @bazigb/game-backgammon -w @bazigb/game-chess -w @bazigb/game-vegas",
    "test:impact": "node scripts/check-impact.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
